{
  "name": "react-native-drum-picker",
  "version": "0.3.0",
  "description": "Cross-platform native drum/wheel picker for React Native (Fabric)",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "DrumPicker.podspec",
    "img",
    "func-gif",
    "LICENSE",
    "CHANGELOG.md",
    "react-native.config.js",
    "src",
    "lib",
    "android",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!example",
    "ios",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.map",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-drum-picker-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "build": "bob build",
    "check:package": "node scripts/check-package-contents.mjs",
    "prepublishOnly": "bob build && node scripts/check-package-contents.mjs",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "react-native-library",
    "android",
    "ios",
    "swift",
    "kotlin",
    "fabric",
    "new-architecture",
    "picker",
    "wheel-picker",
    "drum-picker",
    "date-picker",
    "ios-style"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrollDynasty/react-native-drum-picker.git"
  },
  "author": "Umar Matyokubov <ymarumar502@gmail.com> (https://github.com/scrollDynasty)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scrollDynasty/react-native-drum-picker/issues"
  },
  "homepage": "https://github.com/scrollDynasty/react-native-drum-picker#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "DrumPickerViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.drumpicker"
    },
    "ios": {
      "componentProvider": {
        "DrumPickerView": "DrumPickerView"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "endOfLine": "lf"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-native-community|@testing-library)/)"
    ]
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.62.0"
  }
}
